<Page x:Class="WardogsGameBar.MainWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark">
 <Page.Resources>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#94a3b8"/></Style>
  <Style TargetType="TextBox"><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Background" Value="#111827"/><Setter Property="Foreground" Value="#e2e8f0"/><Setter Property="MinHeight" Value="25"/><Setter Property="Padding" Value="3,1"/></Style>
  <Style TargetType="Button"><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="7,3"/><Setter Property="MinHeight" Value="24"/><Setter Property="Background" Value="#1e293b"/></Style>
 </Page.Resources>
 <Border x:Name="Surface" Background="#0b0f19" BorderBrush="#334155" BorderThickness="1" Padding="10,8">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Spacing="6">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image Source="Assets/logo.png" Width="16" Height="16"/>
   <TextBlock x:Name="Mode" Grid.Column="1" Foreground="#34d399" FontWeight="Bold" VerticalAlignment="Center"/>
   <Button x:Name="SetupButton" Grid.Column="2" Content="F3"/>
   <Button x:Name="HideButton" Grid.Column="3" Content="F4" Margin="4,0,0,0"/>
  </Grid>
  <Grid Background="#111827" Padding="8,5">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="AzimuthTitle" FontSize="10" Foreground="#64748b" FontWeight="Bold"/>
   <TextBlock x:Name="ElevationTitle" Grid.Column="1" FontSize="10" Foreground="#64748b" FontWeight="Bold"/>
   <TextBlock x:Name="DistanceTitle" Grid.Column="2" FontSize="10" Foreground="#64748b" FontWeight="Bold"/>
   <TextBlock x:Name="Azimuth" Grid.Row="1" Text="---.-°" FontFamily="Consolas" FontSize="22" Foreground="#38bdf8" FontWeight="Bold"/>
   <TextBlock x:Name="Elevation" Grid.Row="1" Grid.Column="1" Text="--- mil" FontFamily="Consolas" FontSize="22" Foreground="#fbbf24" FontWeight="Bold"/>
   <TextBlock x:Name="Distance" Grid.Row="1" Grid.Column="2" Text="---" FontFamily="Consolas" FontSize="22" Foreground="#f8fafc" FontWeight="Bold"/>
  </Grid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
   <Grid ColumnSpacing="4" RowSpacing="3"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <Button x:Name="GunButton" HorizontalAlignment="Stretch"/><TextBox x:Name="GunX" Grid.Column="1" PlaceholderText="X: ---" IsReadOnly="True"/><TextBox x:Name="GunY" Grid.Column="2" PlaceholderText="Y: ---" IsReadOnly="True"/>
    <Button x:Name="TargetButton" Grid.Row="1" HorizontalAlignment="Stretch"/><TextBox x:Name="TargetX" Grid.Row="1" Grid.Column="1" PlaceholderText="X: ---" IsReadOnly="True"/><TextBox x:Name="TargetY" Grid.Row="1" Grid.Column="2" PlaceholderText="Y: ---" IsReadOnly="True"/>
   </Grid>
   <Border x:Name="PreviewBorder" Grid.Column="1" Background="#111827" Margin="4,0,0,0" BorderBrush="#1e293b" BorderThickness="1"><Grid><TextBlock Text="OCR" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Preview" Width="64" Height="48" Stretch="Fill"/></Grid></Border>
  </Grid>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#64748b"/>
  <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Background="#111827" Padding="8" Spacing="6">
   <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="LanguageLabel" VerticalAlignment="Center"/><Button x:Name="RuButton" Content="RU"/><Button x:Name="EnButton" Content="EN"/><Button x:Name="ApplyButton"/></StackPanel>
   <TextBlock x:Name="OpacityLabel"/><Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" StepFrequency="1"/>
   <TextBlock x:Name="CaptureLabel"/><Slider x:Name="CaptureSlider" Minimum="160" Maximum="640" StepFrequency="10"/>
   <CheckBox x:Name="PreviewCheck" FontSize="12"/>
   <TextBlock x:Name="HotkeyLabel" TextWrapping="Wrap"/>
   <Grid ColumnSpacing="4" RowSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <TextBox x:Name="KeyGun"/><TextBox x:Name="KeyTarget" Grid.Column="1"/><TextBox x:Name="KeySetup" Grid.Row="1"/><TextBox x:Name="KeyHide" Grid.Row="1" Grid.Column="1"/>
   </Grid>
   <Button x:Name="SaveKeysButton" HorizontalAlignment="Stretch"/>
   <TextBlock x:Name="CaptureHint" TextWrapping="Wrap"/>
   <Button x:Name="CloseButton" Background="#451a1a" Foreground="#f87171" HorizontalAlignment="Stretch"/>
  </StackPanel>
 </StackPanel>
 </ScrollViewer>
 </Border>
</Page>
